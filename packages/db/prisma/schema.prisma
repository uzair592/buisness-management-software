generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(50)
  passwordHash String        @map("password_hash") @db.Text
  email        String?       @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[]

  @@map("users")
}

model Business {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String                 @db.VarChar(100)
  currency               String                 @default("PKR") @db.VarChar(10)
  timezone               String                 @default("Asia/Karachi") @db.VarChar(50)
  datasetEpoch           Int                    @default(1) @map("dataset_epoch") @db.Integer
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  locations              Location[]
  memberships            Membership[]
  deviceEnrollments      DeviceEnrollment[]
  devicePrefixRegistries DevicePrefixRegistry[]
  offlineLeases          OfflineLease[]
  sessions               Session[]
  auditEvents            AuditEvent[]
  accounts               Account[]
  expenseCategories      ExpenseCategory[]
  openingBatches         OpeningBatch[]
  openingDocuments       OpeningDocument[]
  syncHead               SyncHead?
  commandReceipts        CommandReceipt[]
  sourceEvents           SourceEvent[]
  journalEntries         JournalEntry[]
  changeBatches          ChangeBatch[]
  stockMovements         StockMovement[]
  provisionalDeficits    ProvisionalDeficitCost[]
  categories             Category[]
  units                  Unit[]
  taxProfiles            TaxProfile[]
  items                  Item[]
  parties                Party[]
  sales                  SaleDocument[]
  moneyTransfers         MoneyTransfer[]
  purchaseSequence       Int                      @default(0) @map("purchase_sequence") @db.Integer
  creditNoteSequence     Int                      @default(0) @map("credit_note_sequence") @db.Integer
  debitNoteSequence      Int                      @default(0) @map("debit_note_sequence") @db.Integer
  stockAdjustmentSequence Int                     @default(0) @map("stock_adjustment_sequence") @db.Integer
  paymentInSequence      Int                      @default(0) @map("payment_in_sequence") @db.Integer
  paymentOutSequence     Int                      @default(0) @map("payment_out_sequence") @db.Integer
  expenseSequence        Int                      @default(0) @map("expense_sequence") @db.Integer
  purchases              PurchaseDocument[]
  creditNotes            CreditNote[]
  stockAdjustments       StockAdjustment[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  expenses               Expense[]

  @@map("businesses")
}

model Location {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  code              String             @db.VarChar(20)
  name              String             @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deviceEnrollments DeviceEnrollment[]
  memberships       Membership[]
  stockMovements    StockMovement[]
  saleDocuments     SaleDocument[]
  purchaseDocuments PurchaseDocument[]
  creditNotes       CreditNote[]
  stockAdjustments  StockAdjustment[]

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@map("locations")
}

model Membership {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  role              String             @db.VarChar(30)
  permissionVersion Int                @default(1) @map("permission_version") @db.Integer
  locationId        String?            @map("location_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  location          Location?          @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  deviceEnrollments DeviceEnrollment[]
  offlineLeases     OfflineLease[]

  @@unique([businessId, id])
  @@unique([userId, businessId])
  @@map("memberships")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  selectedBusinessId String?   @map("selected_business_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.VarChar(64)
  csrfToken          String    @map("csrf_token") @db.VarChar(64)
  userAgent          String?   @map("user_agent") @db.Text
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedBusiness   Business? @relation(fields: [selectedBusinessId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model DeviceEnrollment {
  id            String         @id @default(uuid()) @db.Uuid
  businessId    String         @map("business_id") @db.Uuid
  membershipId  String         @map("membership_id") @db.Uuid
  locationId    String         @map("location_id") @db.Uuid
  deviceName    String         @map("device_name") @db.VarChar(100)
  numberPrefix  String         @map("number_prefix") @db.VarChar(10)
  saleSequence  BigInt         @default(0) @map("sale_sequence") @db.BigInt
  status        String         @default("Enrolled") @db.VarChar(20)
  enrolledAt    DateTime       @default(now()) @map("enrolled_at") @db.Timestamptz
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership    Membership     @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  location      Location       @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  offlineLeases OfflineLease[]
  commandReceipts CommandReceipt[]
  saleDocuments    SaleDocument[]

  @@unique([businessId, id])
  @@unique([businessId, numberPrefix])
  @@map("device_enrollments")
}

model DevicePrefixRegistry {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  numberPrefix String   @map("number_prefix") @db.VarChar(10)
  enrolledAt   DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, numberPrefix])
  @@map("device_prefix_registry")
}

model OfflineLease {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @map("business_id") @db.Uuid
  deviceEnrollmentId String           @map("device_enrollment_id") @db.Uuid
  membershipId       String           @map("membership_id") @db.Uuid
  datasetEpoch       Int              @map("dataset_epoch") @db.Integer
  policyVersion      Int              @default(1) @map("policy_version") @db.Integer
  issuedAt           DateTime         @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz
  revokedAt          DateTime?        @map("revoked_at") @db.Timestamptz
  signature          String           @db.Text
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deviceEnrollment   DeviceEnrollment @relation(fields: [businessId, deviceEnrollmentId], references: [businessId, id], onDelete: Restrict)
  membership         Membership       @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("offline_leases")
}

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  action     String    @db.VarChar(50)
  details    Json      @default("{}")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}

model Account {
  id             String        @id @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  code           String        @db.VarChar(50)
  classification String        @db.VarChar(30)
  name           String        @db.VarChar(120)
  kind           String        @default("General") @db.VarChar(20)
  expenseCategoryId String?     @map("expense_category_id") @db.Uuid
  version        Int           @default(1)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenseCategory ExpenseCategory? @relation(fields: [businessId, expenseCategoryId], references: [businessId, id], onDelete: Restrict)
  journalLines   JournalLine[]
  salePayments   SalePayment[]
  transfersOut   MoneyTransfer[] @relation("TransferSource")
  transfersIn    MoneyTransfer[] @relation("TransferDestination")
  purchasePayments PurchasePayment[]
  creditNoteRefunds CreditNoteRefund[]
  payments       Payment[]
  expensesPaid   Expense[] @relation("ExpensePaidFromAccount")
  expensesAccount Expense[] @relation("ExpenseAccount")

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@map("accounts")
}

model SaleDocument {
  id                 String           @id @db.Uuid
  businessId         String           @map("business_id") @db.Uuid
  deviceEnrollmentId String           @map("device_enrollment_id") @db.Uuid
  locationId         String           @map("location_id") @db.Uuid
  partyId            String?          @map("party_id") @db.Uuid
  commandId          String           @map("command_id") @db.Uuid
  sourceEventId      String?          @map("source_event_id") @db.Uuid
  number             String?          @db.VarChar(40)
  status             String           @default("Draft") @db.VarChar(12)
  version            Int              @default(1)
  snapshot           Json
  total              Decimal?         @db.Decimal(38, 2)
  paid               Decimal?         @db.Decimal(38, 2)
  due                Decimal?         @db.Decimal(38, 2)
  businessDate       DateTime         @map("business_date") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  postedAt           DateTime?        @map("posted_at") @db.Timestamptz
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deviceEnrollment   DeviceEnrollment @relation(fields: [businessId, deviceEnrollmentId], references: [businessId, id], onDelete: Restrict)
  location           Location         @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  party              Party?           @relation(fields: [businessId, partyId], references: [businessId, id], onDelete: Restrict)
  sourceEvent        SourceEvent?     @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  lines              SaleLine[]
  payments           SalePayment[]
  paymentAllocations PaymentAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, number])
  @@map("sale_documents")
}

model SaleLine {
  id         String       @id @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  saleId     String       @map("sale_id") @db.Uuid
  itemId     String       @map("item_id") @db.Uuid
  snapshot   Json
  sale       SaleDocument @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Restrict)
  item       Item         @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("sale_lines")
}

model SalePayment {
  id          String       @id @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  saleId      String       @map("sale_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  kind        String       @db.VarChar(8)
  applied     Decimal      @db.Decimal(38, 2)
  tendered    Decimal?     @db.Decimal(38, 2)
  reference   String?      @db.VarChar(120)
  sale        SaleDocument @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Restrict)
  account     Account      @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("sale_payments")
}

model OpeningBatch {
  id            String            @id @db.Uuid
  businessId    String            @unique @map("business_id") @db.Uuid
  sourceEventId String            @map("source_event_id") @db.Uuid
  snapshot      Json
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent   SourceEvent       @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  documents     OpeningDocument[]

  @@unique([businessId, id])
  @@map("opening_batches")
}

model OpeningDocument {
  id                String       @id @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  batchId           String       @map("batch_id") @db.Uuid
  partyId           String       @map("party_id") @db.Uuid
  reference         String       @db.VarChar(120)
  direction         String       @db.VarChar(12)
  amount            Decimal      @db.Decimal(38, 2)
  partyNameSnapshot String       @map("party_name_snapshot") @db.VarChar(160)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  batch             OpeningBatch @relation(fields: [businessId, batchId], references: [businessId, id], onDelete: Restrict)
  party             Party        @relation(fields: [businessId, partyId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, batchId, reference, direction])
  @@map("opening_documents")
}

model ExpenseCategory {
  id         String    @id @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(120)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accounts   Account[]
  expenses   Expense[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("expense_categories")
}

model SyncHead {
  businessId      String   @id @map("business_id") @db.Uuid
  datasetEpoch    Int      @map("dataset_epoch")
  committedCursor BigInt   @default(0) @map("committed_cursor") @db.BigInt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("sync_heads")
}

model CommandReceipt {
  businessId         String            @map("business_id") @db.Uuid
  datasetEpoch       Int               @map("dataset_epoch")
  commandId          String            @map("command_id") @db.Uuid
  deviceEnrollmentId String?           @map("device_enrollment_id") @db.Uuid
  payloadHash        String            @map("payload_hash") @db.Char(64)
  outcome            String            @db.VarChar(30)
  canonicalResult    Json              @map("canonical_result")
  cursor             BigInt            @db.BigInt
  acceptedAt         DateTime          @default(now()) @map("accepted_at") @db.Timestamptz
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deviceEnrollment   DeviceEnrollment? @relation(fields: [businessId, deviceEnrollmentId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, datasetEpoch, commandId])
  @@map("command_receipts")
}

model SourceEvent {
  id                  String                   @id @db.Uuid
  businessId          String                   @map("business_id") @db.Uuid
  commandId           String                   @map("command_id") @db.Uuid
  effectKind          String                   @map("effect_kind") @db.VarChar(40)
  businessDate        DateTime                 @map("business_date") @db.Date
  acceptedAt          DateTime                 @default(now()) @map("accepted_at") @db.Timestamptz
  business            Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntries      JournalEntry[]
  stockMovements      StockMovement[]
  provisionalDeficits ProvisionalDeficitCost[]
  changeBatches       ChangeBatch[]
  openingBatches      OpeningBatch[]
  saleDocuments       SaleDocument[]
  moneyTransfers      MoneyTransfer[]
  purchaseDocuments   PurchaseDocument[]
  creditNotes         CreditNote[]
  stockAdjustments    StockAdjustment[]
  payments            Payment[]
  expenses            Expense[]

  @@unique([businessId, id])
  @@unique([businessId, commandId, effectKind])
  @@map("source_events")
}

model MoneyTransfer {
  id                   String      @id @db.Uuid
  businessId           String      @map("business_id") @db.Uuid
  commandId            String      @map("command_id") @db.Uuid
  sourceEventId        String      @map("source_event_id") @db.Uuid
  sourceAccountId      String      @map("source_account_id") @db.Uuid
  destinationAccountId String      @map("destination_account_id") @db.Uuid
  amount               Decimal     @db.Decimal(38, 2)
  reference            String      @db.VarChar(120)
  businessDate         DateTime    @map("business_date") @db.Date
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent          SourceEvent @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  sourceAccount        Account     @relation("TransferSource", fields: [businessId, sourceAccountId], references: [businessId, id], onDelete: Restrict)
  destinationAccount   Account     @relation("TransferDestination", fields: [businessId, destinationAccountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, sourceEventId])
  @@index([businessId, businessDate, id])
  @@map("money_transfers")
}

model JournalEntry {
  id               String         @id @db.Uuid
  businessId       String         @map("business_id") @db.Uuid
  sourceEventId    String         @map("source_event_id") @db.Uuid
  postingKind      String         @map("posting_kind") @db.VarChar(40)
  businessDate     DateTime       @map("business_date") @db.Date
  reversesEntryId  String?        @map("reverses_entry_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent      SourceEvent    @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  reversesEntry    JournalEntry?  @relation("JournalReversal", fields: [businessId, reversesEntryId], references: [businessId, id], onDelete: Restrict)
  reversedBy       JournalEntry[] @relation("JournalReversal")
  lines            JournalLine[]

  @@unique([businessId, id])
  @@unique([businessId, sourceEventId, postingKind])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  debit          Decimal      @default(0) @db.Decimal(38, 2)
  credit         Decimal      @default(0) @db.Decimal(38, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  journalEntry   JournalEntry @relation(fields: [businessId, journalEntryId], references: [businessId, id], onDelete: Restrict)
  account        Account      @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, accountId, createdAt], map: "journal_lines_by_account")
  @@map("journal_lines")
}

model StockMovement {
  id              String      @id @db.Uuid
  businessId      String      @map("business_id") @db.Uuid
  sourceEventId   String      @map("source_event_id") @db.Uuid
  sourceLineId    String      @map("source_line_id") @db.Uuid
  movementKind    String      @map("movement_kind") @db.VarChar(40)
  leg             String      @db.VarChar(20)
  locationId      String      @map("location_id") @db.Uuid
  quantityDelta   Decimal     @map("quantity_delta") @db.Decimal(38, 6)
  valueDelta      Decimal     @map("value_delta") @db.Decimal(38, 2)
  valuationStatus String      @map("valuation_status") @db.VarChar(20)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent     SourceEvent @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  location        Location    @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  itemId          String?     @map("item_id") @db.Uuid
  item            Item?       @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, sourceEventId, sourceLineId, movementKind, leg])
  @@index([businessId, locationId, createdAt], map: "stock_movements_by_location")
  @@map("stock_movements")
}

model ProvisionalDeficitCost {
  id               String      @id @db.Uuid
  businessId       String      @map("business_id") @db.Uuid
  sourceEventId    String      @map("source_event_id") @db.Uuid
  sourceLineId     String      @map("source_line_id") @db.Uuid
  quantityBase     Decimal     @map("quantity_base") @db.Decimal(38, 6)
  provisionalValue Decimal     @map("provisional_value") @db.Decimal(38, 2)
  status           String      @default("Open") @db.VarChar(20)
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent      SourceEvent @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, sourceEventId, sourceLineId])
  @@map("provisional_deficit_costs")
}

model ChangeBatch {
  businessId    String      @map("business_id") @db.Uuid
  datasetEpoch  Int         @map("dataset_epoch")
  cursor        BigInt      @db.BigInt
  sourceEventId String      @map("source_event_id") @db.Uuid
  payload       Json
  committedAt   DateTime    @default(now()) @map("committed_at") @db.Timestamptz
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceEvent   SourceEvent @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, datasetEpoch, cursor])
  @@unique([businessId, sourceEventId])
  @@map("change_batches")
}

model Category {
  id         String    @id @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(120)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items      Item[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("categories")
}

model Unit {
  id          String               @id @db.Uuid
  businessId  String               @map("business_id") @db.Uuid
  code        String               @db.VarChar(20)
  name        String               @db.VarChar(80)
  version     Int                  @default(1)
  archivedAt  DateTime?            @map("archived_at") @db.Timestamptz
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  baseItems   Item[]
  conversions ItemUnitConversion[]

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@map("units")
}

model TaxProfile {
  id         String    @id @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(100)
  rate       Decimal   @db.Decimal(9, 4)
  mode       String    @db.VarChar(12)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items      Item[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("tax_profiles")
}

model Item {
  id             String               @id @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  categoryId     String?              @map("category_id") @db.Uuid
  baseUnitId     String?              @map("base_unit_id") @db.Uuid
  taxProfileId   String?              @map("tax_profile_id") @db.Uuid
  kind           String               @db.VarChar(12)
  name           String               @db.VarChar(160)
  sku            String?              @db.VarChar(60)
  barcode        String?              @db.VarChar(100)
  salePrice      Decimal              @default(0) @map("sale_price") @db.Decimal(38, 2)
  version        Int                  @default(1)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category       Category?            @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  baseUnit       Unit?                @relation(fields: [businessId, baseUnitId], references: [businessId, id], onDelete: Restrict)
  taxProfile     TaxProfile?          @relation(fields: [businessId, taxProfileId], references: [businessId, id], onDelete: Restrict)
  conversions    ItemUnitConversion[]
  stockMovements StockMovement[]
  saleLines      SaleLine[]
  purchaseLines  PurchaseLine[]
  creditNoteLines CreditNoteLine[]
  stockAdjustments StockAdjustment[]

  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, name, id], map: "items_search")
  @@map("items")
}

model ItemUnitConversion {
  id         String    @id @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  factor     Decimal   @db.Decimal(38, 6)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  item       Item      @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)
  unit       Unit      @relation(fields: [businessId, unitId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, itemId, unitId])
  @@map("item_unit_conversions")
}

model Party {
  id         String    @id @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(160)
  isCustomer Boolean   @default(false) @map("is_customer")
  isSupplier Boolean   @default(false) @map("is_supplier")
  phone      String?   @db.VarChar(40)
  email      String?   @db.VarChar(255)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openingDocuments OpeningDocument[]
  saleDocuments    SaleDocument[]
  purchaseDocuments PurchaseDocument[]
  creditNotes      CreditNote[]
  payments         Payment[]

  @@unique([businessId, id])
  @@index([businessId, name, id], map: "parties_search")
  @@map("parties")
}

model PurchaseDocument {
  id                     String            @id @db.Uuid
  businessId             String            @map("business_id") @db.Uuid
  locationId             String            @map("location_id") @db.Uuid
  partyId                String            @map("party_id") @db.Uuid
  commandId              String            @map("command_id") @db.Uuid
  sourceEventId          String?           @map("source_event_id") @db.Uuid
  number                 String?           @db.VarChar(40)
  supplierInvoiceNumber  String            @map("supplier_invoice_number") @db.VarChar(120)
  status                 String            @default("Draft") @db.VarChar(12)
  version                Int               @default(1)
  snapshot               Json
  total                  Decimal?          @db.Decimal(38, 2)
  paid                   Decimal?          @db.Decimal(38, 2)
  due                    Decimal?          @db.Decimal(38, 2)
  businessDate           DateTime          @map("business_date") @db.Date
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz
  postedAt               DateTime?         @map("posted_at") @db.Timestamptz
  business               Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location               Location          @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  party                  Party             @relation(fields: [businessId, partyId], references: [businessId, id], onDelete: Restrict)
  sourceEvent            SourceEvent?      @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  lines                  PurchaseLine[]
  payments               PurchasePayment[]
  paymentAllocations     PaymentAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, number])
  @@index([businessId, partyId, supplierInvoiceNumber])
  @@index([businessId, businessDate, id], map: "purchase_documents_by_date")
  @@map("purchase_documents")
}

model PurchaseLine {
  id         String           @id @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  purchaseId String           @map("purchase_id") @db.Uuid
  itemId     String           @map("item_id") @db.Uuid
  snapshot   Json
  purchase   PurchaseDocument @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  item       Item             @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("purchase_lines")
}

model PurchasePayment {
  id         String           @id @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  purchaseId String           @map("purchase_id") @db.Uuid
  accountId  String           @map("account_id") @db.Uuid
  kind       String           @db.VarChar(8)
  applied    Decimal          @db.Decimal(38, 2)
  reference  String?          @db.VarChar(120)
  purchase   PurchaseDocument @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  account    Account          @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("purchase_payments")
}

model CreditNote {
  id                 String              @id @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  kind               String              @db.VarChar(20)
  originalDocumentId String              @map("original_document_id") @db.Uuid
  locationId         String              @map("location_id") @db.Uuid
  partyId            String?             @map("party_id") @db.Uuid
  commandId          String              @map("command_id") @db.Uuid
  sourceEventId      String?             @map("source_event_id") @db.Uuid
  number             String?             @db.VarChar(40)
  status             String              @default("Draft") @db.VarChar(12)
  version            Int                 @default(1)
  reason             String              @db.Text
  snapshot           Json
  subtotal           Decimal?            @db.Decimal(38, 2)
  taxTotal           Decimal?            @map("tax_total") @db.Decimal(38, 2)
  total              Decimal?            @db.Decimal(38, 2)
  allocatedCredit    Decimal?            @map("allocated_credit") @db.Decimal(38, 2)
  refundedAmount     Decimal?            @map("refunded_amount") @db.Decimal(38, 2)
  customerCredit     Decimal?            @map("customer_credit") @db.Decimal(38, 2)
  businessDate       DateTime            @map("business_date") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location           Location            @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  party              Party?              @relation(fields: [businessId, partyId], references: [businessId, id], onDelete: Restrict)
  sourceEvent        SourceEvent?        @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  lines              CreditNoteLine[]
  refunds            CreditNoteRefund[]

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, number])
  @@index([businessId, businessDate, id], map: "credit_notes_by_date")
  @@index([businessId, originalDocumentId], map: "credit_notes_by_original_doc")
  @@map("credit_notes")
}

model CreditNoteLine {
  id                 String              @id @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  creditNoteId       String              @map("credit_note_id") @db.Uuid
  originalLineId     String              @map("original_line_id") @db.Uuid
  itemId             String              @map("item_id") @db.Uuid
  quantity           Decimal             @db.Decimal(38, 6)
  unitPrice          Decimal             @map("unit_price") @db.Decimal(38, 2)
  subtotal           Decimal             @db.Decimal(38, 2)
  taxAmount          Decimal             @default(0) @map("tax_amount") @db.Decimal(38, 2)
  total              Decimal             @db.Decimal(38, 2)
  disposition        String              @db.VarChar(20)
  snapshot           Json
  creditNote         CreditNote          @relation(fields: [businessId, creditNoteId], references: [businessId, id], onDelete: Restrict)
  item               Item                @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("credit_note_lines")
}

model CreditNoteRefund {
  id                 String              @id @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  creditNoteId       String              @map("credit_note_id") @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  kind               String              @db.VarChar(8)
  amount             Decimal             @db.Decimal(38, 2)
  reference          String?             @db.VarChar(120)
  creditNote         CreditNote          @relation(fields: [businessId, creditNoteId], references: [businessId, id], onDelete: Restrict)
  account            Account             @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@map("credit_note_refunds")
}

model StockAdjustment {
  id                 String              @id @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  locationId         String              @map("location_id") @db.Uuid
  itemId             String              @map("item_id") @db.Uuid
  commandId          String              @map("command_id") @db.Uuid
  sourceEventId      String?             @map("source_event_id") @db.Uuid
  adjustmentKind     String              @map("adjustment_kind") @db.VarChar(30)
  countedQuantity    Decimal?            @map("counted_quantity") @db.Decimal(38, 6)
  systemQuantity     Decimal?            @map("system_quantity") @db.Decimal(38, 6)
  quantityDelta      Decimal             @map("quantity_delta") @db.Decimal(38, 6)
  unitCost           Decimal             @map("unit_cost") @db.Decimal(38, 2)
  valueDelta         Decimal             @map("value_delta") @db.Decimal(38, 2)
  reason             String              @db.Text
  status             String              @default("Draft") @db.VarChar(12)
  businessDate       DateTime            @map("business_date") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location           Location            @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  item               Item                @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)
  sourceEvent        SourceEvent?        @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@index([businessId, businessDate, id], map: "stock_adjustments_by_date")
  @@map("stock_adjustments")
}

model Payment {
  id                String              @id @db.Uuid
  businessId        String              @map("business_id") @db.Uuid
  commandId         String              @map("command_id") @db.Uuid
  sourceEventId     String?             @map("source_event_id") @db.Uuid
  partyId           String              @map("party_id") @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  paymentKind       String              @map("payment_kind") @db.VarChar(12)
  number            String?             @db.VarChar(32)
  amount            Decimal             @db.Decimal(38, 2)
  allocatedAmount   Decimal             @default(0) @map("allocated_amount") @db.Decimal(38, 2)
  unallocatedAmount Decimal             @default(0) @map("unallocated_amount") @db.Decimal(38, 2)
  reference         String?             @db.VarChar(120)
  note              String?             @db.Text
  status            String              @default("Draft") @db.VarChar(12)
  businessDate      DateTime            @map("business_date") @db.Date
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party             Party               @relation(fields: [businessId, partyId], references: [businessId, id], onDelete: Restrict)
  account           Account             @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)
  sourceEvent       SourceEvent?        @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)
  allocations       PaymentAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, number])
  @@index([businessId, businessDate, id], map: "payments_by_date")
  @@map("payments")
}

model PaymentAllocation {
  id                 String            @id @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  paymentId          String            @map("payment_id") @db.Uuid
  saleDocumentId     String?           @map("sale_document_id") @db.Uuid
  purchaseDocumentId String?           @map("purchase_document_id") @db.Uuid
  allocatedAmount    Decimal           @map("allocated_amount") @db.Decimal(38, 2)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payment            Payment           @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
  saleDocument       SaleDocument?     @relation(fields: [businessId, saleDocumentId], references: [businessId, id], onDelete: Restrict)
  purchaseDocument   PurchaseDocument? @relation(fields: [businessId, purchaseDocumentId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, paymentId], map: "payment_allocations_payment")
  @@index([businessId, saleDocumentId], map: "payment_allocations_sale")
  @@index([businessId, purchaseDocumentId], map: "payment_allocations_purchase")
  @@map("payment_allocations")
}

model Expense {
  id                 String            @id @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  commandId          String            @map("command_id") @db.Uuid
  sourceEventId      String?           @map("source_event_id") @db.Uuid
  expenseCategoryId  String            @map("expense_category_id") @db.Uuid
  expenseAccountId   String            @map("expense_account_id") @db.Uuid
  paidFromAccountId  String            @map("paid_from_account_id") @db.Uuid
  number             String?           @db.VarChar(32)
  amount             Decimal           @db.Decimal(38, 2)
  taxAmount          Decimal           @default(0) @map("tax_amount") @db.Decimal(38, 2)
  reference          String?           @db.VarChar(120)
  note               String?           @db.Text
  status             String            @default("Draft") @db.VarChar(12)
  businessDate       DateTime          @map("business_date") @db.Date
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  postedAt           DateTime?         @map("posted_at") @db.Timestamptz

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenseCategory    ExpenseCategory   @relation(fields: [businessId, expenseCategoryId], references: [businessId, id], onDelete: Restrict)
  expenseAccount     Account           @relation("ExpenseAccount", fields: [businessId, expenseAccountId], references: [businessId, id], onDelete: Restrict)
  paidFromAccount    Account           @relation("ExpensePaidFromAccount", fields: [businessId, paidFromAccountId], references: [businessId, id], onDelete: Restrict)
  sourceEvent        SourceEvent?      @relation(fields: [businessId, sourceEventId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, commandId])
  @@unique([businessId, number])
  @@index([businessId, businessDate, id], map: "expenses_by_date")
  @@map("expenses")
}
