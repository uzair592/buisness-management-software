{
  "name": "business-management-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && pnpm -r typecheck",
    "test": "tsx --test tests/api.test.ts tests/decimal.test.ts tests/local-db.test.ts",
    "test:db": "tsx --test tests/db.test.ts tests/db-isolation.test.ts tests/identity-api.test.ts",
    "test:runtime": "tsx --test tests/runtime.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "db:generate": "pnpm --filter @business/db generate",
    "db:provision": "pnpm --filter @business/db provision",
    "db:migrate": "pnpm db:provision && pnpm --filter @business/db migrate",
    "db:repair-history": "pnpm --filter @business/db repair-history"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.0.0",
    "fake-indexeddb": "6.2.5",
    "globals": "^16.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
